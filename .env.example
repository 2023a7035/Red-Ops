# ===================================================================
# REDOPS PLATFORM CONFIGURATION
# Automated Enterprise Red Team Assessment and Attack Simulation Platform
# ===================================================================

# Application Environment
FLASK_ENV=development
FLASK_DEBUG=1
SECRET_KEY=redops-sec-key-cyber-defense-2026

# Server Bind Settings
HOST=127.0.0.1
PORT=5000

# Scope & Safety Enforcement
# Comma-separated list of strictly authorized IP targets / subnets
AUTHORIZED_TARGETS=127.0.0.1,172.28.0.0/16,192.168.1.0/24,10.0.0.0/24,localhost
ENFORCE_STRICT_ALLOWLIST=true

# Vulnerability Database / NVD API Configuration
# Optional: NVD API Key for faster rate-limits (5 req/30s without key; 50 req/30s with key)
NVD_API_KEY=
NVD_CACHE_TTL_HOURS=24

# AI Reasoning Engine Configuration
# Supported providers: local (deterministic rule-based fallback), openai, gemini, anthropic
AI_PROVIDER=local
OPENAI_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
LLM_MODEL=gpt-4o-mini

# Database Path
DATABASE_PATH=database/redops.db
